@model List<eVote360.Core.Application.Dtos.Admin.Usuario.UsuarioDto>

@{
    ViewData["Title"] = "Usuarios";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-light mb-0">@ViewData["Title"]</h2>
            <small class="text-muted">
                Total registrados: @Model.Count
            </small>
        </div>

        <a asp-action="Create"
           class="btn btn-success px-4">
            Crear usuario
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end" style="width:240px;">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var u in Model)
                            {
                                <tr>

                                    <!-- Nombre + Email -->
                                    <td>
                                        <div class="fw-semibold">
                                            @u.Nombre @u.Apellido
                                        </div>
                                        <div class="text-muted small">
                                            @u.Email
                                        </div>
                                    </td>

                                    <!-- Username -->
                                    <td>
                                        @u.UserName
                                    </td>

                                    <!-- Rol -->
                                    <td>
                                        <span class="badge bg-dark">
                                            @u.Rol
                                        </span>
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        @if (u.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <!-- Acciones -->
                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@u.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            Editar
                                        </a>

                                        <form asp-action="SetActive"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@u.Id" />

                                            <input type="hidden"
                                                   name="active"
                                                   value="@(u.IsActive ? "false" : "true")" />

                                            <button type="submit"
                                                    class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success")">

                                                @(u.IsActive ? "Desactivar" : "Activar")

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center py-4 text-muted">
                                    No hay usuarios registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>