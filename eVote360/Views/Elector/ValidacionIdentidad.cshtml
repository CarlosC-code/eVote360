@model ValidacionOcrViewModel

@{
    ViewData["Title"] = "Validación de identidad";
}

<div class="container py-5">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <!-- Header -->
                    <div class="text-center mb-4">
                        <h2 class="fw-light mb-1">@ViewData["Title"]</h2>
                        <p class="text-muted small mb-0">
                            Suba una imagen clara del frente de su cédula para validar su identidad
                        </p>
                    </div>

                    <form asp-action="ValidacionIdentidad"
                          method="post"
                          enctype="multipart/form-data">

                        <input type="hidden" asp-for="DocumentoDigitado" />

                        <!-- Foto cédula -->
                        <div class="mb-3">
                            <label asp-for="FotoCedulaFrontal"
                                   class="form-label fw-semibold">
                                Foto frontal de la cédula
                            </label>

                            <input asp-for="FotoCedulaFrontal"
                                   class="form-control"
                                   type="file"
                                   accept="image/*" />

                            <span asp-validation-for="FotoCedulaFrontal"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Validar
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
