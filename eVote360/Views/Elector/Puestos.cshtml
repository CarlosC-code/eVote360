@model List<eVote360.Core.Application.Dtos.Admin.PuestoElectivo.PuestoElectivoDto>

@{
    ViewData["Title"] = "Seleccione el puesto a votar";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="text-center mb-4">
        <h2 class="fw-light mb-1">@ViewData["Title"]</h2>
        <p class="text-muted small mb-0">
            Seleccione un puesto para visualizar los candidatos disponibles
        </p>
        <hr class="mt-3" />
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">

                    @if (Model?.Count == 0)
                    {
                        <div class="text-center py-5">
                            <h6 class="text-muted mb-0">
                                No hay puestos disponibles en la elección activa
                            </h6>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">

                            @foreach (var p in Model)
                            {
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3"
                                   asp-action="Votar"
                                   asp-route-puestoId="@p.Id">

                                    <span>
                                        <span class="fw-semibold">
                                            @p.Nombre
                                        </span>
                                        <br />
                                        <small class="text-muted">
                                            @p.Descripcion
                                        </small>
                                    </span>

                                    <span class="text-muted">
                                        →
                                    </span>

                                </a>
                            }

                        </div>
                    }

                </div>
            </div>

            <!-- Botón finalizar -->
            <div class="text-end mt-4">
                <form asp-action="Finalizar" method="post">
                    <button type="submit"
                            class="btn btn-success px-4">
                        Finalizar votación
                    </button>
                </form>
            </div>

        </div>
    </div>

</div>