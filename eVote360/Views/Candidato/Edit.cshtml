@model CandidatoEditViewModel

@{
    ViewData["Title"] = "Editar candidato";
    var partidoId = ViewBag.PartidoId as int? ?? 0;
    Layout = "_LayoutDirigente";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-10">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        <input asp-for="Id" type="hidden" />
                        <input type="hidden" name="partidoId" value="@partidoId" />

                        <div class="row">

                            <!-- Datos -->
                            <div class="col-md-8">

                                <div class="mb-4">
                                    <label asp-for="Nombre"
                                           class="form-label fw-semibold"></label>

                                    <input asp-for="Nombre"
                                           class="form-control form-control-sm" />

                                    <span asp-validation-for="Nombre"
                                          class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Apellido"
                                           class="form-label fw-semibold"></label>

                                    <input asp-for="Apellido"
                                           class="form-control form-control-sm" />

                                    <span asp-validation-for="Apellido"
                                          class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Foto"
                                           class="form-label fw-semibold">
                                        Foto (opcional)
                                    </label>

                                    <input asp-for="Foto"
                                           type="file"
                                           class="form-control form-control-sm"
                                           accept="image/*" />

                                    <span asp-validation-for="Foto"
                                          class="text-danger small"></span>
                                </div>

                            </div>

                            <!-- Foto actual -->
                            <div class="col-md-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingFotoPath))
                                {
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">
                                            Foto actual
                                        </label>

                                        <div class="border rounded p-2 text-center">
                                            <img src="~/@Model.ExistingFotoPath"
                                                 class="img-fluid rounded" />
                                        </div>

                                        <input type="hidden"
                                               asp-for="ExistingFotoPath" />
                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-end gap-2 mt-3">

                            <a asp-action="Index"
                               asp-route-partidoId="@partidoId"
                               class="btn btn-outline-secondary btn-sm px-3">
                                Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-success btn-sm px-3">
                                Guardar
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}