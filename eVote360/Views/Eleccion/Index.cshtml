@model List<eVote360.Core.Application.Dtos.Elecciones.EleccionDto>

@{
    ViewData["Title"] = "Elecciones";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>

        <a asp-action="Create"
           class="btn btn-success btn-sm px-3">
            + Iniciar proceso electivo
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <h6 class="text-muted mb-0">
                        No hay procesos electivos registrados
                    </h6>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold">Nombre</th>
                                <th class="fw-semibold">Fecha</th>
                                <th class="fw-semibold">Estado</th>
                                <th style="width:260px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var e in Model)
                            {
                                <tr>

                                    <!-- Nombre -->
                                    <td class="fw-semibold">
                                        @e.Nombre
                                    </td>

                                    <!-- Fecha -->
                                    <td>
                                        @e.FechaRealizacion.ToString("yyyy-MM-dd")
                                    </td>

                                    <!-- Estado -->
                                    <td>
                                        @if (e.Estado == eVote360.Core.Domain.Common.Enums.ElectionStatus.EnProceso)
                                        {
                                            <span class="badge bg-success-subtle text-success border">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border">
                                                Finalizada
                                            </span>
                                        }
                                    </td>

                                    <!-- Acciones -->
                                    <td class="text-end">

                                        @if (e.Estado == eVote360.Core.Domain.Common.Enums.ElectionStatus.EnProceso)
                                        {
                                            <form asp-action="Finalizar"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">
                                                    Finalizar
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Resumen"
                                                  method="post"
                                                  class="d-inline">

                                                <input type="hidden"
                                                       name="year"
                                                       value="@e.FechaRealizacion.Year" />

                                                <button type="submit"
                                                        class="btn btn-outline-primary btn-sm">
                                                    Ver resumen @e.FechaRealizacion.Year
                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>