@{
    ViewData["Title"] = "Resumen por año";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>
        <hr class="mt-2" />
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Resumen"
                  method="post"
                  class="row g-3 align-items-end">

                <!-- Año -->
                <div class="col-md-4">
                    <label for="year"
                           class="form-label fw-semibold">
                        Año
                    </label>

                    <input type="number"
                           class="form-control"
                           name="year"
                           id="year"
                           value="@DateTime.Today.Year"
                           min="2000"
                           max="2100" />
                </div>

                <!-- Botón -->
                <div class="col-md-4">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        Obtener resumen
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>