@model PartidoEditViewModel

@{
    ViewData["Title"] = "Editar partido";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>
        <hr class="mt-2" />
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input asp-for="Id" type="hidden" />

                <div class="row g-4">

                    <!-- Columna principal -->
                    <div class="col-md-8">

                        <div class="mb-3">
                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="Descripcion"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Siglas"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Siglas"
                                   class="form-control" />

                            <span asp-validation-for="Siglas"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Logo"
                                   class="form-label fw-semibold">
                                Logo (opcional)
                            </label>

                            <input asp-for="Logo"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <span asp-validation-for="Logo"
                                  class="text-danger small">
                            </span>
                        </div>

                    </div>

                    <!-- Columna lateral -->
                    <div class="col-md-4">

                        @if (!string.IsNullOrWhiteSpace(Model.ExistingLogoPath))
                        {
                            <div class="card border-0 shadow-sm">
                                <div class="card-body text-center">

                                    <label class="form-label fw-semibold">
                                        Logo actual
                                    </label>

                                    <div class="border rounded p-3 bg-light mb-2">
                                        <img src="~/@Model.ExistingLogoPath"
                                             class="img-fluid"
                                             style="max-height:180px; object-fit:contain;" />
                                    </div>

                                    <input type="hidden"
                                           asp-for="ExistingLogoPath" />

                                </div>
                            </div>
                        }

                    </div>

                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Volver
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Guardar
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}