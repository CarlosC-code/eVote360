@model List<eVote360.Core.Application.Dtos.Elecciones.ResultadoPuestoDto>

@{
    ViewData["Title"] = "Resultados por elección";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>
        <hr class="mt-2" />
    </div>

    @if (Model?.Count == 0)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-4 text-muted">
                No hay resultados disponibles para esta elección.
            </div>
        </div>
    }
    else
    {
        @foreach (var puesto in Model)
        {
            <div class="card shadow-sm border-0 mb-4">

                <!-- Card Header -->
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        Puesto @puesto.PuestoElectivoId
                    </span>

                    <span class="badge bg-primary">
                        @puesto.Resultados.Sum(r => r.Votos) votos totales
                    </span>
                </div>

                <!-- Tabla -->
                <div class="card-body p-0">
                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>Candidato</th>
                                    <th>Partido</th>
                                    <th class="text-end">Votos</th>
                                    <th class="text-end">%</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in puesto.Resultados
                                                        .OrderByDescending(x => x.Votos))
                                {
                                    <tr>

                                        <td class="fw-semibold">
                                            @item.CandidatoNombreCompleto
                                        </td>

                                        <td>
                                            <span class="badge bg-dark">
                                                @item.PartidoSiglas
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            @item.Votos
                                        </td>

                                        <td class="text-end">
                                            @item.Porcentaje
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>

            </div>
        }
    }

</div>