@{
    ViewData["Title"] = "Alianzas";
    var partidoId = ViewBag.PartidoId as int? ?? 0;
    var pendientes = ViewBag.Pendientes as IEnumerable<eVote360.Core.Application.Dtos.Dirigente.Alianza.AlianzaSolicitudDto> ?? Enumerable.Empty<eVote360.Core.Application.Dtos.Dirigente.Alianza.AlianzaSolicitudDto>();
    var enviadas = ViewBag.Enviadas as IEnumerable<eVote360.Core.Application.Dtos.Dirigente.Alianza.AlianzaSolicitudDto> ?? Enumerable.Empty<eVote360.Core.Application.Dtos.Dirigente.Alianza.AlianzaSolicitudDto>();
    var activas = ViewBag.Activas as IEnumerable<eVote360.Core.Application.Dtos.Dirigente.Alianza.AlianzaDto> ?? Enumerable.Empty<eVote360.Core.Application.Dtos.Dirigente.Alianza.AlianzaDto>();
    Layout = "_LayoutDirigente";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>

        <a asp-action="CrearSolicitud"
           asp-route-partidoId="@partidoId"
           class="btn btn-success btn-sm px-3">
            + Nueva solicitud
        </a>
    </div>

    <div class="row g-4">

        <!-- Pendientes -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title mb-3">Pendientes recibidas</h5>

                    @if (!pendientes.Any())
                    {
                        <p class="text-muted">No hay solicitudes pendientes</p>
                    }
                    else
                    {
                        @foreach (var s in pendientes)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="mb-2">
                                    <div><strong>Solicitante Id:</strong> @s.PartidoSolicitanteId</div>
                                    <small class="text-muted">@s.FechaSolicitudUtc.ToString("yyyy-MM-dd")</small>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="Aceptar" method="post" class="d-inline">
                                        <input type="hidden" name="solicitudId" value="@s.Id" />
                                        <input type="hidden" name="partidoId" value="@partidoId" />
                                        <button class="btn btn-outline-success btn-sm">Aceptar</button>
                                    </form>

                                    <form asp-action="Rechazar" method="post" class="d-inline">
                                        <input type="hidden" name="solicitudId" value="@s.Id" />
                                        <input type="hidden" name="partidoId" value="@partidoId" />
                                        <button class="btn btn-outline-danger btn-sm">Rechazar</button>
                                    </form>
                                </div>

                            </div>
                        }
                    }

                </div>
            </div>
        </div>

        <!-- Enviadas -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title mb-3">Solicitudes enviadas</h5>

                    @if (!enviadas.Any())
                    {
                        <p class="text-muted">No has enviado solicitudes</p>
                    }
                    else
                    {
                        @foreach (var s in enviadas)
                        {
                            <div class="border rounded p-3 mb-3">

                                <div class="mb-2">
                                    <div><strong>Destino Id:</strong> @s.PartidoDestinoId</div>
                                    <small class="text-muted">
                                        @s.FechaSolicitudUtc.ToString("yyyy-MM-dd") — @s.Estado
                                    </small>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <form asp-action="EliminarSolicitud" method="post" class="d-inline">
                                        <input type="hidden" name="solicitudId" value="@s.Id" />
                                        <input type="hidden" name="partidoId" value="@partidoId" />
                                        <button class="btn btn-outline-danger btn-sm">Eliminar</button>
                                    </form>
                                </div>

                            </div>
                        }
                    }

                </div>
            </div>
        </div>

        <!-- Activas -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">

                    <h5 class="card-title mb-3">Alianzas activas</h5>

                    @if (!activas.Any())
                    {
                        <p class="text-muted">No hay alianzas activas</p>
                    }
                    else
                    {
                        @foreach (var a in activas)
                        {
                            <div class="border rounded p-3 mb-3">
                                <div><strong>Partidos:</strong> @a.PartidoAId ↔ @a.PartidoBId</div>
                                <small class="text-muted">
                                    Desde @a.FechaAceptacionUtc.ToString("yyyy-MM-dd")
                                </small>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>

    </div>

</div>