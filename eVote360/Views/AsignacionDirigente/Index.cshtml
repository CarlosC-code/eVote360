@model List<(int AsignacionId, int UsuarioId, string UsuarioNombre, int PartidoId, string PartidoSiglas)>

@{
    ViewData["Title"] = "Asignación de dirigentes a partidos";
    Layout = "_LayoutAdmin";
}

<div class="container py-4">

    <partial name="~/Views/Shared/_Alerts.cshtml" />

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-light mb-0">@ViewData["Title"]</h2>

        <a asp-action="Create"
           class="btn btn-success btn-sm px-3">
            + Crear
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <h6 class="text-muted mb-0">
                        No hay asignaciones registradas
                    </h6>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="fw-semibold">Dirigente</th>
                                <th class="fw-semibold">Partido</th>
                                <th style="width:160px;"></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var x in Model)
                            {
                                <tr>
                                    <td>@x.UsuarioNombre</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @x.PartidoSiglas
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="Delete"
                                              method="post"
                                              class="d-inline">
                                            <input type="hidden" name="id" value="@x.AsignacionId" />
                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
